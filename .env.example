# USDX consumer app — environment variables (USDX-150)
# Copy to .env.local for local dev. All NEXT_PUBLIC_* vars inline at build time.

# Base URL of the backend API (consumer endpoints live under /api/v2/*).
# Leave empty for local/offline dev — the app falls back to the in-memory mock layer.
# Example (Railway): https://usdx-api.up.railway.app
NEXT_PUBLIC_API_BASE_URL=

# Force the mock API on/off. Unset = auto (mock when API base URL is empty).
# Set to "false" in deployed environments (dev/staging/prod) to require the real backend.
# NEXT_PUBLIC_USE_MOCK=false

# Checkout own-hosted (repo `checkout`, mint.usdx.co.id). After POST /v2/mint the app
# redirects to `${this}/checkout/{orderId}#token=<jwt>` — bearer JWT lewat URL hash
# (USDX-240, supersede cross-subdomain cookie). Default (kalau unset) = domain prod.
# Override per environment (dev → checkout dev) untuk E2E lintas-domain.
NEXT_PUBLIC_CHECKOUT_URL=https://mint.usdx.co.id

# ── Redeem on-chain (USDX-263) ────────────────────────────────────────────────
# USDX token proxy on Polygon — target of the burn `redeem(redeemId, amountWei)`
# and the balanceOf precondition read. MUST match the backend's `contractAddress`.
# Unset → zero address (the mock path never reads it). Required for real redeem.
NEXT_PUBLIC_USDX_CONTRACT_ADDRESS=

# WalletConnect Cloud project id for RainbowKit. The demo fallback works for
# injected wallets (MetaMask) + the offline test seam; set a real id for deployed
# environments so WalletConnect / mobile wallets connect.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Dedicated Polygon RPC for on-chain reads (balanceOf) + the burn tx. Unset →
# wagmi's default public RPC (rate-limited; fine for local dev).
# NEXT_PUBLIC_POLYGON_RPC_URL=

# Show the "Mode simulasi" notice on the redeem tracker: in W3 the burn is real
# but the IDR payout is still mocked (prod is gated REDEEM_DISABLED). Defaults on;
# set "false" once a real disbursement provider ships.
# NEXT_PUBLIC_REDEEM_SIMULATED_PAYOUT=false
